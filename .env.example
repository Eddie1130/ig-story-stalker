# Instagram accounts to monitor, comma-separated (without @). IDs resolve after login.
IG_TARGET_USERNAMES=example_username,another_username
# Legacy single-account fallback, used only when IG_TARGET_USERNAMES is unset/empty.
# IG_TARGET_USERNAME=example_username
# Optional numeric ID override for legacy single-account mode only.
# IG_TARGET_USER_ID=
IG_CHECK_INTERVAL_SECONDS=300
# Enable private per-user Telegram menus; existing target list is imported once.
IG_TELEGRAM_CONTROL=1

# Temporary noVNC login session. Keep the default bind address unless you use
# a trusted private network or another secure access layer.
VNC_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_PASSWORD
NOVNC_BIND_ADDRESS=127.0.0.1
NOVNC_PORT=6080

# Host download directory. Relative paths are resolved from this project.
IG_DOWNLOAD_DIR=./downloads
# Each account has its own stories/, posts/ and highlight/ under downloads/<username>/.
IG_CATALOG_ENABLED=1
IG_POSTS_INTERVAL_SECONDS=900
IG_HIGHLIGHTS_INTERVAL_SECONDS=900
# Instagram private GraphQL IDs may need updating when Instagram changes.
IG_POSTS_DOC_ID=28322872020710458
IG_POSTS_PAGE_DOC_ID=39535953862670189
# X / Twitter integration (managed subscriptions persist in Telegram settings)
X_ENABLED=1
X_TARGET_USERNAMES=
X_CHECK_INTERVAL_SECONDS=300
X_HISTORY_ENABLED=1
X_ACCOUNTS_DIR=./data/x-accounts

# Optional TikTok catalog browser fallback (1 enabled, 0 HTTP-only).
TIKTOK_CATALOG_BROWSER=1
# Interactive TikTok login stays on localhost. Uses VNC_PASSWORD above.
TIKTOK_LOGIN_BIND_ADDRESS=127.0.0.1
TIKTOK_LOGIN_PORT=6081
