#!/bin/sh
set -eu
cd "$(dirname "$0")"

if [ "${1:-}" = "down" ]; then
    shift
    set -- --profile '*' down "$@"
fi

exec docker compose \
    -f docker-compose.yml \
    -f compose.watch.yml \
    -f compose.health.yml \
    -f compose.x.yml \
    -f compose.tiktok.yml \
    -f compose.export.yml \
    "$@"