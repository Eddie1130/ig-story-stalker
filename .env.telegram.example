# Create a bot with BotFather, then send the bot a message before testing.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

# Private-chat control owner. Defaults to TELEGRAM_CHAT_ID when it is a positive
# private user ID. Required explicitly if the legacy destination is a group.
# TELEGRAM_OWNER_USER_ID=123456789
# Additional approved users, comma-separated Telegram numeric user IDs.
# Restart ig-telegram after changing this list. Each user must /start the bot.
# TELEGRAM_ALLOWED_USER_IDS=987654321,123123123
