{
  "name": "ig-story-stalker",
  "version": "0.1.0",
  "description": "Self-hosted Instagram Story watcher with Telegram delivery and read-receipt guards",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/*.mjs",
    "test": "npm run check && node --test",
    "test:export": "python3 -m unittest discover -s test -p runtime_export.py -v"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright-core": "1.55.0"
  }
}
